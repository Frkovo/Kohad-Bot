# === Discord Developer Portal ===
# Application → Bot → Reset Token 后粘贴
DISCORD_TOKEN=
DISCORD_APP_ID=
# 开发期：注册 Guild 命令（即时生效）；留空 = 注册全局命令（生效慢，注意 200 次/天配额）
DISCORD_GUILD_ID=

# === 8788 迁移服务（跨机建议 HTTPS + 反向代理 + IP 白名单）===
# 也可填 Tailscale / 内网地址（http 仅限可信网络；API key 会随请求发送）。
MIGRATE_URL=https://your-domain.example
# 与 8788 的 SDGB_MIGRATION_API_KEY 保持一致
MIGRATE_API_KEY=

# === /opt：SDGB 更新包（DLI 查询在 8788，下载与落盘在 Bot 所在机器）===
# 默认 /app/.data/sdgb-update；compose 已把宿主机 ./data 挂到 /app/.data，
# 即 /opt/kohad-bot/data/sdgb-update。
# SDGB_UPDATE_DIR=/app/.data/sdgb-update
# 文案里展示的宿主机路径（可选）
# SDGB_UPDATE_DISPLAY_DIR=/opt/kohad-bot/data/sdgb-update
# auto = 直连 CDN，失败改走 8788 的 /api/opt/range；direct / proxy 可强制
# SDGB_OPT_TRANSPORT=auto
# 片间隔毫秒（0 = 全速；1000 ≈ 官机 8KB/s）
# SDGB_OPT_PACE_MS=0
# 默认分片字节：0 = 整文件单请求（默认）；8192 = 官机节奏，需要配合 PACE_MS
# SDGB_OPT_PART_SIZE=
# 同一片连续失败上限
# SDGB_OPT_MAX_RETRIES=200
# 单次任务已探测总量上限（0 = 不限）
# SDGB_OPT_MAX_BYTES=0
# 允许下载的 CDN 主机后缀
# SDGB_OPT_HOST_ALLOWLIST=wahlap.com,sys-allnet.cn
# 定时探测新 .opt（分钟；0 = 关闭）；只私信提醒，不自动下载
# SDGB_OPT_POLL_MINUTES=10
# 自动探测使用的 title_ver
# SDGB_OPT_TITLE_VER=1.56
# 新包私信通知的用户 ID（逗号/空格分隔）；留空 = 私信应用 owner
# SDGB_OPT_NOTIFY_USER_IDS=
# 分享链接：站点根（默认 OAUTH_PUBLIC_BASE）、有效期秒（0 = 永久）、签名密钥（空 = B50_AUTH_KEY 或 .data/opt-link.key）
# SDGB_OPT_PUBLIC_BASE=https://kohad-bot.frkovo.uk
# SDGB_OPT_LINK_TTL_SECONDS=604800
# SDGB_OPT_LINK_SECRET=

# === 安全 ===
# 允许使用的 Discord 用户 ID，逗号/空格分隔；留空 = 允许所有人（启动时会告警）
ALLOWED_USER_IDS=
# 导出响应是否仅调用者可见；成绩图/帮助公开，upload/绑定始终私密
EPHEMERAL=true
# 附件阈值（MB）：超过则 gzip，再超过则拆分（上限 10 个分片）
MAX_ATTACHMENT_MB=7
# 调用 8788 的总超时（毫秒）
CALL_TIMEOUT_MS=240000
# 每用户新扫码冷却（秒），0 = 关闭；查本地图/帮助/复用二维码不受影响
COOLDOWN_SECONDS=30
# Bot 机台读取并发与含运行任务的队列总容量
PULL_CONCURRENCY=3
MAX_PENDING_READS=9
# 迁移服务也需要更新；在 server/.env 配置 MIGRATE_CONCURRENCY（默认 3）

# === 已有水鱼绑定兼容配置（DC-only 模式不再发起新网页绑定）===
# 登记后需单独「生成 client_secret」（只显示一次）；scope 含 prober.records.write 需人工审核
# 未获写权限时仍保存国服本地成绩并报告同步状态
# 水鱼 OAuth 暂时旁路（默认关闭，改用用户自备 Import-Token）；=1 恢复 OAuth
DF_OAUTH_ENABLED=0
DF_CLIENT_ID=
DF_CLIENT_SECRET=
# DF_AUTH_URL=https://auth.diving-fish.com
# DF_SCOPE=prober.records.read prober.records.write

# === 存储：MySQL（玩家数据）+ Redis（扫码去重、冷却与令牌缓存）===
# docker compose 下由 compose.yaml 传入：MYSQL_HOST=mysql / REDIS_URL=redis://redis:6379/0
# 直接用 MYSQL_URL 也可以：mysql://user:password@host:3306/kohad
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kohad
MYSQL_USER=kohad
MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD 仅 compose 创建 MySQL 容器时使用，Bot 进程不需要
MYSQL_ROOT_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
# 渲染缓存与日志目录（容器内为 /app/.data，挂载到宿主机 ./data）；玩家数据不在这个目录里
# B50_DATA_DIR=.data

# 排障日志：默认写入 B50_DATA_DIR/logs/bot-debug.jsonl（5 MB 轮转，保留一个 .1 备份）。
# 设为 off 关闭文件日志（控制台仍输出安全元数据）；或填写路径覆盖默认位置。
# B50_DEBUG_LOG=off
# B50_DEBUG_LOG=.data/logs/bot-debug.jsonl

# maimai NET（JP / 国际服）的中间证书已内置于 assets/certs/（来源见 PROVENANCE.md），无需配置。
# 请勿设置 NODE_TLS_REJECT_UNAUTHORIZED=0 等关闭证书校验的选项。

# === 落雪（LXNS）开发者 API（https://maimai.lxns.net/developer 申请开发者后获取）===
# 鉴权格式：Authorization: <密钥>（无 Bearer）；绑定方式：好友码（/bindlx）
LX_DEV_TOKEN=
# LX_API_BASE=https://maimai.lxns.net
# B50_NEW_VERSION=25500  # B15 新曲版本阈值（落雪版本号；25500 = 舞萌DX 2026）

# === 已有落雪 OAuth 绑定续期配置；新的 /bindlx 只使用好友码弹窗 ===
# LX_CLIENT_ID=
# LX_CLIENT_SECRET=
# 未登记回调时留空；登记后需与开发者面板中的 URI 完全一致
# LX_REDIRECT_URI=

# === 多服务器 NET 登录：确认后加密持久化 SEGA ID、密码和 Cookie ===
# 未配置 B50_AUTH_KEY 时首次绑定自动创建 B50_DATA_DIR 下的 binding-master.key；
# 容器部署建议直接配置 B50_AUTH_KEY，务必保留原密钥，备份数据库时必须一并备份。
# 不得提交 .data 或真实密钥。
# 可选：32 字节密钥的 Base64（配置后优先于密钥文件）
# B50_AUTH_KEY=
# B50_AUTH_KEY_FILE=.data/binding-master.key
# 默认从各地区可用曲目推断版本；维护者可固定实际机台/NET 版本：
# 名称必须匹配 dxdata，例如 CiRCLE / CiRCLE PLUS / MAGiCAL
# NET_JP_VERSION=
# NET_INTL_VERSION=
# 可替换经核对的 DXRating 格式曲库；默认 assets/data/dxdata.json
# B50_DXDATA_FILE=

# === MuNET（mumur）：卡号直连，同国服的 Aime 流程 ===
# 绑定时输入 20 位 Aime 卡号，经 AllNet PowerOn → AimeDB 查 userId → 明文接口只读拉取。不登录、不写入游戏数据。
# 机台 keychip 必须是 MuNET 已登记的（PowerOn 与 AimeDB 都会拒绝未登记的 keychip）。
MUMUR_KEYCHIP=
# MUMUR_POWERON_URL=http://play.mumur.net/sys/servlet/PowerOn
# MUMUR_AIME_HOST=aime.mumur.net
# MUMUR_GAME=SDEZ
# MUMUR_GAME_VERSION=1.70
# MUMUR_CHART_VERSION=MAGiCAL

# === Missless：当前旁路，填写也不会启用（服务端与接口未核实前不接入） ===
# MISSLESS_SCORE_ENDPOINT=
# MISSLESS_ADAPTER_TOKEN=
# MISSLESS_ADAPTER_TOKEN=
# MISSLESS_RATING_POLICY=net

# OAuth callback listener (落雪网页授权回调). Put a reverse proxy in front: https://kohad-bot.frkovo.uk/oauth-callback/* -> http://127.0.0.1:3729
# docker compose 里 compose.yaml 会覆盖为 0.0.0.0，由反向代理转发到容器端口。
OAUTH_HOST=127.0.0.1
OAUTH_PORT=3729
OAUTH_PUBLIC_BASE=https://kohad-bot.frkovo.uk
# LX_CLIENT_ID / LX_CLIENT_SECRET: from the 落雪开发者面板 OAuth app. Register the callback below in that app.
# Default redirect: ${OAUTH_PUBLIC_BASE}/oauth-callback/lxns . Set LX_REDIRECT_URI= (empty) to use the "无回调地址" mode instead.

# Diving-Fish web OAuth. Callback is ${OAUTH_PUBLIC_BASE}/oauth-callback/diving-fish (register it in the 水鱼 developer console).
# DF_SCOPE defaults to read-only. Add prober.records.write only after 水鱼 approves the write scope.
# DF_REDIRECT_URI=
